{
	"schemaVersion": 1,
	"id": "test-mod",
	"version": "${version}",
	"name": "Test Mod",
	"description": "A test mod for learning Fabric mod development.",
	"authors": [
		"Jacko"
	],
	"contact": {
		"sources": "https://github.com/JJ-Jacko/test-mod"
	},
	"icon": "assets/test-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.jacko.testmod.TMCommon"
		],
		"client": [
			"com.jacko.testmod.client.TMClient"
		],
		"fabric-datagen": [
			"com.jacko.testmod.client.TMData"
		]
	},
	"mixins": [
		"test-mod.mixins.json",
		{
			"config": "test-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}